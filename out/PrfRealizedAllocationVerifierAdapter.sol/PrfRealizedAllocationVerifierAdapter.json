\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"verifierIdentityHash\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"expectedStatementRoot\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"proof\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"publicValues\",\"type\":\"bytes\"}],\"name\":\"verifyStatementProof\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"verifyStatementProof(bytes32,bytes,bytes)\":{\"details\":\"Reverts (fail-closed) if the SP1 proof is invalid or the public      values do not decode to the expected statement root.      Returns the extracted statement root on success.\"}},\"title\":\"PrfRealizedAllocationVerifierAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"extractStatementRoot(bytes)\":{\"notice\":\"Extract only the statement root from public values (no proof verification).\"},\"publicValuesSchema()\":{\"notice\":\"The public-values schema hash (e.g. keccak256(\\\"evm-bytes32-v1\\\")).\"},\"statementSchemaVersion()\":{\"notice\":\"The statement schema version committed by the SP1 guest (hash of string).\"},\"verifierIdentityHash()\":{\"notice\":\"Returns the verifier identity hash committed by this adapter.         Encodes programVKey + elfSha256 + statementSchemaVersion +         publicValuesSchema + verifier address.\"},\"verifyStatementProof(bytes32,bytes,bytes)\":{\"notice\":\"Verify that the SP1 proof is valid AND the public values yield         the expected statement root.\"}},\"notice\":\"Binds the realized-allocation-statement.v1 SP1 program to the         EVM verification gateway.         Two duties:         1.