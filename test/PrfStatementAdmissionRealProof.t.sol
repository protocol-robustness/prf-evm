pragma solidity ^0.8.33;

import {Test} from "forge-std/Test.sol";

import {SP1Verifier} from "@sp1-contracts/v6.1.0/SP1VerifierGroth16.sol";
import {PrfChainInstanceGenesis} from "../src/core/PrfChainInstanceGenesis.sol";
import {SewGovernanceAuthorityAdapter} from "../src/integrations/sew/SewGovernanceAuthorityAdapter.sol";
import {SewConfigurationExecutor} from "../src/integrations/sew/SewConfigurationExecutor.sol";
import {PrfRealizedAllocationVerifierAdapter} from "../src/verification/adapters/PrfRealizedAllocationVerifierAdapter.sol";
import {PrfVerifierRegistry} from "../src/core/PrfVerifierRegistry.sol";
import {PrfStatementAdmission} from "../src/core/PrfStatementAdmission.sol";
import {PrfAssuredOperationConsumer} from "../src/consumers/PrfAssuredOperationConsumer.sol";
import {IPrfStatementAdmission} from "../src/interfaces/IPrfStatementAdmission.sol";
import {IPrfVerifierRegistry} from "../src/interfaces/IPrfVerifierRegistry.sol";
import {ISP1Verifier} from "../src/verification/interfaces/ISP1Verifier.sol";

/// @title PrfStatementAdmissionRealProofTest
/// @notice Positive and negative conformance tests that exercise the ACTUAL
///         SP1 Groth16 Solidity verifier (from sp1-contracts v6.1.0) through the
///         PrfRealizedAllocationVerifierAdapter -> PrfStatementAdmission path.
///
///         The proof is generated by the real SP1 CPU prover (not mock), using
///         the existing realized-statement-sp1-program guest on the pinned
///         scenario input. Circuit version: v6.1.0 (matches sp1-contracts v6.1.0
///         Solidity verifiers and SP1_CIRCUIT_VERSION in sp1-prover 6.3.1).
contract PrfStatementAdmissionRealProofTest is Test {
    bytes32 internal constant PROTOCOL_ROOT =
        0xd77429dd50bd7fe18d5f41d55e53ccbd4c67d18c4f00b266f86dbaede01f9343;
    bytes32 internal constant AUTHORITY_STATE_ROOT =
        0x150c28318e27fffacd9233c7ace128f7639f16c47d1c844e5440a07db39867cd;
    bytes32 internal constant CHAIN_INSTANCE_ROOT =
        0xf6c0f226998ebecb1123f78c2b30347d24c6e7ca2131f44f880b8a43c052cf86;

    bytes32 internal constant CONFIG_ROOT_0 =
        0xa3b808fa66ad9b9c4f35de5590ad95213cf0de76190db5980ced743f39f97f57;

    bytes32 internal constant CONFIG_ROOT_1 =
        0x785f9b5c1a92ba54bd8f6dcaef3e416f4ab8e3b7f708310e92535c640ddbbc6d;

    bytes32 internal constant DECISION_ROOT =
        0x2db92fa9655c0fb44cf984c4ebcda53885f7812db3b5368b937821f3c223c66b;
    uint8 internal constant TARGET_MODE_DIRECT = 0;

    bytes32 internal constant FIXTURE_VKEY =
        0x00b9325e81961e4b6dfbe6fa7806796a15c018116225c85f5ef0811afc331d3f;
    bytes32 internal constant FIXTURE_ELF_SHA256 =
        0xdeed502019f2cc920aa92e36e15d429c8ace7406cce925195709dc353b3e2495;

    bytes32 internal constant FIXTURE_STATEMENT_ROOT =
        0xc22333a16df1c1efa352e9daab42ccbd78f4a1d7530ee3ed3cf7527ba62cbd81;

    bytes internal constant FIXTURE_PUBLIC_VALUES =
        hex"c22333a16df1c1efa352e9daab42ccbd78f4a1d7530ee3ed3cf7527ba62cbd81";

    bytes32 internal constant REALIZED_ALLOC_VERIFIER_ID =
        keccak256("realized-allocation-statement.v1");
    bytes32 internal constant FIXTURE_PV_SCHEMA_HASH =
        keccak256("evm-bytes32-v1");
    bytes32 internal constant WRONG_VKEY_VERIFIER_ID =
        keccak256("wrong-vkey-verifier.v1");
    bytes32 internal constant WRONG_VKEY = 0xdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef;
    bytes32 internal constant WRONG_VERIFIER_ID =
        keccak256("wrong-verifier.v1");
    bytes32 internal constant WRONG_STATEMENT_ROOT =
        0xdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef;

    bytes internal constant FIXTURE_PROOF = hex"";

    SewGovernanceAuthorityAdapter internal authority;
    PrfChainInstanceGenesis internal genesis;
    SewConfigurationExecutor internal executor;
    PrfVerifierRegistry internal registry;
    SP1Verifier internal sp1Groth16Verifier;
    PrfRealizedAllocationVerifierAdapter internal realAdapter;

    bytes32 internal VERIFIER_REGISTRY_ROOT_0;
    bytes32 internal VERIFIER_REGISTRY_ROOT_1;

    bytes32 internal realVkey;
    bytes internal realPublicValues;
    bytes32 internal realElfSha256;
    bytes32 internal realStatementRoot;
    bytes internal realProof;

    function setUp() public {
        authority = new SewGovernanceAuthorityAdapter(
            PROTOCOL_ROOT,
            address(this),
            AUTHORITY_STATE_ROOT
        );

        genesis = new PrfChainInstanceGenesis(
            PROTOCOL_ROOT,
            block.chainid,
            1,
            address(authority),
            AUTHORITY_STATE_ROOT,
            CONFIG_ROOT_0,
            address(this)
        );

        genesis.sealGenesis(
            CHAIN_INSTANCE_ROOT,
            address(genesis).codehash,
            address(authority).codehash
        );

        registry = new PrfVerifierRegistry(address(this));

        sp1Groth16Verifier = new SP1Verifier();

        realAdapter = new PrfRealizedAllocationVerifierAdapter(
            ISP1Verifier(address(sp1Groth16Verifier)),
            FIXTURE_VKEY,
            FIXTURE_ELF_SHA256,
            "realized-allocation-statement.v1",
            "evm-bytes32-v1"
        );

        // --- Compute canonical R1 root ---
        bytes32[] memory r1Ids = new bytes32[](2);
        address[] memory r1Adapters = new address[](2);
        bytes32[] memory r1Vkeys = new bytes32[](2);
        bytes32[] memory r1ElfHashes = new bytes32[](2);
        string[] memory r1ProgramIds = new string[](2);
        bytes32[] memory r1SchemaHashes = new bytes32[](2);
        bytes32[] memory r1PvSchemas = new bytes32[](2);
        bool[] memory r1Actives = new bool[](2);

        r1Ids[0] = REALIZED_ALLOC_VERIFIER_ID;
        r1Adapters[0] = address(realAdapter);
        r1Vkeys[0] = FIXTURE_VKEY;
        r1ElfHashes[0] = FIXTURE_ELF_SHA256;
        r1ProgramIds[0] = "realized-allocation-proof.v1";
        r1SchemaHashes[0] = keccak256("realized-allocation-statement.v1");
        r1PvSchemas[0] = FIXTURE_PV_SCHEMA_HASH;
        r1Actives[0] = true;

        PrfRealizedAllocationVerifierAdapter wrongVkeyAdapter =
            new PrfRealizedAllocationVerifierAdapter(
                ISP1Verifier(address(sp1Groth16Verifier)),
                WRONG_VKEY,
                FIXTURE_ELF_SHA256,
                "realized-allocation-statement.v1",
                "evm-bytes32-v1"
            );

        r1Ids[1] = WRONG_VKEY_VERIFIER_ID;
        r1Adapters[1] = address(wrongVkeyAdapter);
        r1Vkeys[1] = WRONG_VKEY;
        r1ElfHashes[1] = FIXTURE_ELF_SHA256;
        r1ProgramIds[1] = "realized-allocation-proof.v1";
        r1SchemaHashes[1] = keccak256("realized-allocation-statement.v1");
        r1PvSchemas[1] = FIXTURE_PV_SCHEMA_HASH;
        r1Actives[1] = true;

        VERIFIER_REGISTRY_ROOT_1 = registry.computeCanonicalRoot(
            r1Ids, r1Adapters, r1Vkeys, r1ElfHashes, r1ProgramIds, r1SchemaHashes, r1PvSchemas, r1Actives
        );

        for (uint256 i = 0; i < r1Ids.length; i++) {
            registry.registerVerifier(
                VERIFIER_REGISTRY_ROOT_1,
                r1Ids[i],
                r1Adapters[i],
                r1Vkeys[i],
                r1ElfHashes[i],
                r1ProgramIds[i],
                r1SchemaHashes[i],
                FIXTURE_PV_SCHEMA_HASH
            );
        }
        registry.sealRegistry(VERIFIER_REGISTRY_ROOT_1);

        // --- Compute canonical R0 root (empty registry) ---
        bytes32[] memory emptyIds = new bytes32[](0);
        address[] memory emptyAddrs = new address[](0);
        bytes32[] memory emptyBytes32s = new bytes32[](0);
        string[] memory emptyStrings = new string[](0);
        bool[] memory emptyBools = new bool[](0);

        VERIFIER_REGISTRY_ROOT_0 = registry.computeCanonicalRoot(
            emptyIds, emptyAddrs, emptyBytes32s, emptyBytes32s, emptyStrings, emptyBytes32s, emptyBytes32s, emptyBools
        );

        registry.sealRegistry(VERIFIER_REGISTRY_ROOT_0);

        executor = new SewConfigurationExecutor(
            genesis,
            authority,
            registry,
            VERIFIER_REGISTRY_ROOT_0
        );

        authority.authoriseDecision(
            DECISION_ROOT,
            TARGET_MODE_DIRECT,
            CHAIN_INSTANCE_ROOT,
            CONFIG_ROOT_0,
            CONFIG_ROOT_1,
            VERIFIER_REGISTRY_ROOT_0,
            VERIFIER_REGISTRY_ROOT_1,
            1
        );

        executor.applyConfiguration(
            DECISION_ROOT,
            CONFIG_ROOT_1,
            VERIFIER_REGISTRY_ROOT_1,
            1,
            TARGET_MODE_DIRECT,
            CHAIN_INSTANCE_ROOT,
            new bytes32[](0)
        );

        realVkey = FIXTURE_VKEY;
        realPublicValues = FIXTURE_PUBLIC_VALUES;
        realElfSha256 = FIXTURE_ELF_SHA256;
        realStatementRoot = FIXTURE_STATEMENT_ROOT;
        realProof = FIXTURE_PROOF;
    }

    function test_R1_PositiveRealProofAdmission() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        bytes32 receiptId = admission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            realProof,
            realPublicValues
        );

        assertTrue(receiptId != bytes32(0));
        IPrfStatementAdmission.AdmissionReceipt memory receipt = admission.admissionReceipt(receiptId);
        assertTrue(receipt.exists);
        assertEq(receipt.statementRoot, realStatementRoot);
        assertEq(receipt.publicValuesDigest, sha256(realPublicValues));
        assertEq(receipt.verifierId, REALIZED_ALLOC_VERIFIER_ID);
        assertEq(receipt.verifierAdapter, address(realAdapter));
        assertEq(receipt.programVKey, FIXTURE_VKEY);
        assertEq(admission.admittedCount(), 1);
    }

    function test_R1_RealProofAdmission_EnforcesMatchingOperation() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );
        PrfAssuredOperationConsumer consumer = new PrfAssuredOperationConsumer(
            IPrfStatementAdmission(address(admission)),
            address(this)
        );
        bytes32 operationId = keccak256("real-proof-operation");
        consumer.createOperation(operationId, realStatementRoot, CONFIG_ROOT_1, 1);

        bytes32 receiptId = admission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            realProof,
            realPublicValues
        );
        consumer.applyOperation(operationId, receiptId);

        assertTrue(consumer.operation(operationId).applied);
        assertEq(consumer.operation(operationId).admissionReceiptId, receiptId);
    }

    function test_R1_VerifierBoundToExactConfigRoot() public {
        PrfStatementAdmission wrongConfigAdmission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_0,
            1
        );

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.ConfigurationMismatch.selector,
            CONFIG_ROOT_0,
            CONFIG_ROOT_1
        ));
        wrongConfigAdmission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            realProof,
            realPublicValues
        );
    }

    function test_R2_TamperedProofBytesRejects() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        bytes memory tamperedProof = new bytes(realProof.length);
        for (uint256 i = 0; i < realProof.length; i++) {
            tamperedProof[i] = realProof[i];
        }
        tamperedProof[0] ^= 0x01;

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.ProofVerificationFailed.selector
        ));
        admission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            tamperedProof,
            realPublicValues
        );
    }

    function test_R3_TamperedPublicValuesRejects() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        bytes memory tamperedPv = new bytes(32);
        for (uint256 i = 0; i < 32; i++) {
            tamperedPv[i] = realPublicValues[i];
        }
        tamperedPv[0] ^= 0x01;

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.ProofVerificationFailed.selector
        ));
        admission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            realProof,
            tamperedPv
        );
    }

    function test_R4_WrongVKeyRejects() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.ProofVerificationFailed.selector
        ));
        admission.admitStatement(
            WRONG_VKEY_VERIFIER_ID,
            realStatementRoot,
            realProof,
            realPublicValues
        );
    }

    function test_R5_WrongStatementRootRejects() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.ProofVerificationFailed.selector
        ));
        admission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            WRONG_STATEMENT_ROOT,
            realProof,
            realPublicValues
        );
    }

    function test_R6_WrongEpochRejects() public {
        PrfStatementAdmission wrongEpochAdmission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            999
        );

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.EpochMismatch.selector,
            uint64(999),
            uint64(1)
        ));
        wrongEpochAdmission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            realProof,
            realPublicValues
        );
    }

    function test_R7_InactiveVerifierRejects() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        vm.expectRevert(abi.encodeWithSelector(
            IPrfVerifierRegistry.VerifierNotFound.selector,
            VERIFIER_REGISTRY_ROOT_1,
            WRONG_VERIFIER_ID
        ));
        admission.admitStatement(
            WRONG_VERIFIER_ID,
            realStatementRoot,
            realProof,
            realPublicValues
        );
    }

    function test_R8_MockProofUnderRealVerifierRejects() public {
        PrfStatementAdmission admission = new PrfStatementAdmission(
            genesis,
            executor,
            registry,
            CONFIG_ROOT_1,
            1
        );

        vm.expectRevert(abi.encodeWithSelector(
            PrfStatementAdmission.ProofVerificationFailed.selector
        ));
        admission.admitStatement(
            REALIZED_ALLOC_VERIFIER_ID,
            realStatementRoot,
            new bytes(0),
            realPublicValues
        );
    }

    function test_R9_AdapterRejectsWrongPublicValuesSchema() public {
        PrfRealizedAllocationVerifierAdapter wrongSchemaAdapter =
            new PrfRealizedAllocationVerifierAdapter(
                ISP1Verifier(address(sp1Groth16Verifier)),
                FIXTURE_VKEY,
                FIXTURE_ELF_SHA256,
                "realized-allocation-statement.v1",
                "evm-bytes64-v1"
            );

        vm.expectRevert(abi.encodeWithSelector(
            PrfRealizedAllocationVerifierAdapter.PublicValuesSchemaMismatch.selector,
            keccak256("evm-bytes32-v1"),
            keccak256("evm-bytes64-v1")
        ));
        wrongSchemaAdapter.extractStatementRoot(realPublicValues);
    }
}
